{
  "version": "round19-source-selected-before-new-structural-predictions",
  "scope": "New FeS/active-center structural challenge, selected from experimental RCSB metadata by biological organization and wild-type source; not a random population sample.",
  "selection_reason": "NiFe conventional chain, NiFe multicomponent HydABCSL and FeFe accessory-domain diversity; remaining sources reserved before development prediction. Exact sequence/homolog and taxonomic overlap must be audited before any independent performance claim.",
  "planned_development_target": {
    "precision": 0.95,
    "min_evaluable_site_recall": 0.5,
    "required_truth": "Exact experimental cluster type and complete protein-ligand coordinates; no cofactor-occupancy claim"
  },
  "rules": [
    "Do not add challenge/future sources to templates or identity prototypes.",
    "Freeze source sequence and truth before predicting each development challenge.",
    "All selected physical FeS sites must be accounted for, including missing deposited connections or incomplete ligands; no outcome-based source deletion.",
    "Incomplete gold or unsupported multi-chain truth is separately reported; unknown predictions do not count as correct type assignments.",
    "Reserved sources must not be predicted until stage calibration and source-independence audits are locked.",
    "Huc structures of the same source sequence are technical repeats, not independent Huc validation; that gap remains explicit."
  ],
